#!/usr/bin/env bash
# acceptance-061-080 (WO-063): the three release checks of episodes 061-080 (the Fabric), with evidence logs.
# Usage: scripts/acceptance-061-080 [--only N]      (run via `just acceptance-061-080`)
#   10 fabric-gate    just fabric-gate    every Fabric check and every neg-fabric-* test
#   11 fabric-demo    just fabric-demo    create, impact, undo, commit, reopen, crash at FP4, recover
#   12 check-full     just check-full     the release gate (about 15 minutes; it runs fabric-gate again through check)
# Each item writes build/acceptance/<n>-<name>.log: the command, its exit code, `git rev-parse HEAD`, a tree
# hash of the working tree (sha256 of the sorted per-file sha256 list of `git ls-files` tracked + untracked, not
# ignored), the tool versions, then the command output. Items 1-9 belong to acceptance-041-048 and
# acceptance-049-060 and are not touched.
# Exit 1 when any item fails. No network.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

only=""
case "${1:-}" in
  "") ;;
  --only)
    only="${2:-}"
    case "$only" in 10 | 11 | 12) ;; *)
      echo "usage: scripts/acceptance-061-080 [--only 10|11|12]" >&2
      exit 2
      ;;
    esac
    ;;
  *)
    echo "usage: scripts/acceptance-061-080 [--only 10|11|12]" >&2
    exit 2
    ;;
esac

outdir="$root/build/acceptance"
mkdir -p "$outdir"

head_rev="$(git rev-parse HEAD 2>/dev/null || echo none)"
tree_hash="$(
  git ls-files -z --cached --others --exclude-standard | LC_ALL=C sort -z |
    while IFS= read -r -d '' f; do
      if [ -f "$f" ]; then sha256sum -- "$f"; fi
    done | sha256sum | cut -d' ' -f1
)"

tool_versions() {
  local t
  for t in clang++ g++ cmake ninja just clang-format python3 git; do
    if command -v "$t" >/dev/null 2>&1; then
      printf '%-13s %s\n' "$t" "$("$t" --version 2>&1 | head -n 1)"
    else
      printf '%-13s absent\n' "$t"
    fi
  done
}
versions="$(tool_versions)"

summary=()
failed=0

# write_log <n-name> <command text> <exit code> <status> <output file>
write_log() {
  {
    echo "item:      $1"
    echo "command:   $2"
    echo "exit code: $3"
    echo "status:    $4"
    echo "HEAD:      $head_rev"
    echo "tree hash: $tree_hash (sha256 over sorted per-file sha256 of tracked + untracked files)"
    echo "date:      $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "tools:"
    printf '%s\n' "$versions" | sed 's/^/  /'
    echo "--- output ---"
    cat "$5"
  } >"$outdir/$1.log"
}

# run_item <n> <name> <command text>: runs it under bash -e, writes the evidence log, records the result
run_item() {
  local n="$1" name="$2" cmdtext="$3" start rc=0 tmp
  start=$SECONDS
  tmp="$(mktemp)"
  echo "acceptance: [$n $name] $cmdtext"
  bash -euo pipefail -c "$cmdtext" >"$tmp" 2>&1 || rc=$?
  tail -n 3 "$tmp"
  local status=ok
  if [ "$rc" -ne 0 ]; then
    status=FAIL
    failed=1
  fi
  write_log "$n-$name" "$cmdtext" "$rc" "$status" "$tmp"
  rm -f "$tmp"
  summary+=("$(printf '%-3s %-12s %-8s exit %-3s %s s' "$n" "$name" "$status" "$rc" "$((SECONDS - start))")")
}

wanted() { [ -z "$only" ] || [ "$only" = "$1" ]; }

wanted 10 && run_item 10 fabric-gate "just fabric-gate"
wanted 11 && run_item 11 fabric-demo "just fabric-demo"
wanted 12 && run_item 12 check-full "just check-full"

echo
echo "acceptance-061-080 summary (HEAD $head_rev, tree ${tree_hash:0:16}); logs in build/acceptance/"
printf '  %s\n' "${summary[@]}"
if [ "$failed" -ne 0 ]; then
  echo "acceptance-061-080: FAIL"
  exit 1
fi
echo "acceptance-061-080: ok"
