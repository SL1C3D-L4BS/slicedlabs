#!/usr/bin/env bash
# acceptance-041-048 (WO-020): the four starter-prompt checks of episodes 041-048, with evidence logs.
# Usage: scripts/acceptance-041-048 [--only N]      (run via `just acceptance-041-048`)
#   1 fresh-clone      just fresh-clone-check
#   2 neg-format       just neg-format
#   3 neg-features     just neg-feature-removed, then just neg-probe-never-fails
#   4 episodes-doc     docs/episodes/041-048.md exists (WO-021 writes it); missing is reported PENDING and
#                      does not fail the run
# Each item writes build/acceptance/<n>-<name>.log: the command, its exit code, `git rev-parse HEAD`, a tree
# hash of the working tree (sha256 of the sorted per-file sha256 list of `git ls-files` tracked + untracked,
# not ignored), the tool versions, then the command output.
# Exit 1 when any of items 1-3 fails; item 4 never fails. No network.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

only=""
case "${1:-}" in
  "") ;;
  --only)
    only="${2:-}"
    case "$only" in 1 | 2 | 3 | 4) ;; *)
      echo "usage: scripts/acceptance-041-048 [--only 1|2|3|4]" >&2
      exit 2
      ;;
    esac
    ;;
  *)
    echo "usage: scripts/acceptance-041-048 [--only 1|2|3|4]" >&2
    exit 2
    ;;
esac

outdir="$root/build/acceptance"
mkdir -p "$outdir"

head_rev="$(git rev-parse HEAD 2>/dev/null || echo none)"
tree_hash="$(
  git ls-files -z --cached --others --exclude-standard | LC_ALL=C sort -z |
    while IFS= read -r -d '' f; do
      if [ -f "$f" ]; then sha256sum -- "$f"; fi
    done | sha256sum | cut -d' ' -f1
)"

tool_versions() {
  local t
  for t in clang++ g++ cmake ninja just clang-format python3 git; do
    if command -v "$t" >/dev/null 2>&1; then
      printf '%-13s %s\n' "$t" "$("$t" --version 2>&1 | head -n 1)"
    else
      printf '%-13s absent\n' "$t"
    fi
  done
}
versions="$(tool_versions)"

summary=()
failed=0

# write_log <n-name> <command text> <exit code> <status> <output file>
write_log() {
  {
    echo "item:      $1"
    echo "command:   $2"
    echo "exit code: $3"
    echo "status:    $4"
    echo "HEAD:      $head_rev"
    echo "tree hash: $tree_hash (sha256 over sorted per-file sha256 of tracked + untracked files)"
    echo "date:      $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "tools:"
    printf '%s\n' "$versions" | sed 's/^/  /'
    echo "--- output ---"
    cat "$5"
  } >"$outdir/$1.log"
}

# run_item <n> <name> <command text>: runs it under bash -e, writes the evidence log, records the result
run_item() {
  local n="$1" name="$2" cmdtext="$3" start rc=0 tmp
  start=$SECONDS
  tmp="$(mktemp)"
  echo "acceptance: [$n $name] $cmdtext"
  bash -euo pipefail -c "$cmdtext" >"$tmp" 2>&1 || rc=$?
  tail -n 3 "$tmp"
  local status=ok
  if [ "$rc" -ne 0 ]; then
    status=FAIL
    failed=1
  fi
  write_log "$n-$name" "$cmdtext" "$rc" "$status" "$tmp"
  rm -f "$tmp"
  summary+=("$(printf '%-3s %-14s %-8s exit %-3s %s s' "$n" "$name" "$status" "$rc" "$((SECONDS - start))")")
}

wanted() { [ -z "$only" ] || [ "$only" = "$1" ]; }

wanted 1 && run_item 1 fresh-clone "just fresh-clone-check"
wanted 2 && run_item 2 neg-format "just neg-format"
wanted 3 && run_item 3 neg-features "just neg-feature-removed && just neg-probe-never-fails"
if wanted 4; then
  tmp="$(mktemp)"
  if [ -f docs/episodes/041-048.md ]; then
    echo "docs/episodes/041-048.md exists" >"$tmp"
    write_log 4-episodes-doc "test -f docs/episodes/041-048.md" 0 ok "$tmp"
    summary+=("$(printf '%-3s %-14s %-8s exit %-3s %s s' 4 episodes-doc ok 0 0)")
  else
    echo "docs/episodes/041-048.md is missing (WO-021 writes it)" >"$tmp"
    write_log 4-episodes-doc "test -f docs/episodes/041-048.md" 0 PENDING "$tmp"
    summary+=("$(printf '%-3s %-14s %-8s exit %-3s %s s' 4 episodes-doc PENDING 0 0)")
  fi
  rm -f "$tmp"
fi

echo
echo "acceptance-041-048 summary (HEAD $head_rev, tree ${tree_hash:0:16}); logs in build/acceptance/"
printf '  %s\n' "${summary[@]}"
if [ "$failed" -ne 0 ]; then
  echo "acceptance-041-048: FAIL"
  exit 1
fi
echo "acceptance-041-048: ok"
