{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slicedlabs.example/gen/fabric.provenance.text.schema.json",
  "title": "Canonical text of module fabric.provenance (ARCH1-R29, generated by tools/fabric/slgen.py)",
  "$defs": {
    "fabric.provenance.digest_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$"
      },
      "description": "Content digests in order."
    },
    "fabric.provenance.epistemic_class": {
      "enum": [
        "observed",
        "imported",
        "asserted",
        "calculated",
        "inferred",
        "accepted"
      ],
      "description": "Epistemic class of a record write (ARCH1-R42)."
    },
    "fabric.provenance.id_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:prj_01|sch_02|typ_03|ast_04|ent_05|ins_06|drv_07|txn_08|evt_09|act_0A|pkg_0B|elm_0C|nsp_0D|ope_0E|imp_0F)0[4-9A-HJK][0-9A-HJKMNP-TV-Z]{22}$"
      },
      "description": "Record ids in order."
    },
    "fabric.provenance.input_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:prj_01|sch_02|typ_03|ast_04|ent_05|ins_06|drv_07|txn_08|evt_09|act_0A|pkg_0B|elm_0C|nsp_0D|ope_0E|imp_0F)0[4-9A-HJK][0-9A-HJKMNP-TV-Z]{22}$",
          "description": "Record id of the input."
        },
        "digest": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Content digest of the input record."
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "additionalProperties": false,
      "description": "One input of a derivation: record id and content digest."
    },
    "fabric.provenance.provenance": {
      "type": "object",
      "properties": {
        "input_ids": {
          "$ref": "#/$defs/fabric.provenance.id_list",
          "description": "Record ids of the inputs."
        },
        "input_revisions": {
          "$ref": "#/$defs/fabric.provenance.digest_list",
          "description": "Record content digests of the inputs, one per id."
        },
        "toolchain_id": {
          "type": "string",
          "description": "Id of the toolchain that derived the record."
        },
        "parameters_digest": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Digest of the derivation parameters."
        },
        "environment_hash": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Hash of the derivation environment."
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Exactly the five F3 fields; a missing one is provenance_incomplete (ARCH1-R43)."
    }
  }
}
