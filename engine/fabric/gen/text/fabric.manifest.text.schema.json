{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slicedlabs.example/gen/fabric.manifest.text.schema.json",
  "title": "Canonical text of module fabric.manifest (ARCH1-R29, generated by tools/fabric/slgen.py)",
  "$defs": {
    "fabric.manifest.format_version": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Major version: a change readers of an older major refuse."
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Minor version: additive changes within the major."
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false,
      "description": "A major.minor format or module version."
    },
    "fabric.manifest.manifest": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^(?:prj_01|sch_02|typ_03|ast_04|ent_05|ins_06|drv_07|txn_08|evt_09|act_0A|pkg_0B|elm_0C|nsp_0D|ope_0E|imp_0F)0[4-9A-HJK][0-9A-HJKMNP-TV-Z]{22}$",
          "description": "Project id of the project."
        },
        "name": {
          "type": "string",
          "description": "Display name of the project."
        },
        "writer_format": {
          "$ref": "#/$defs/fabric.manifest.format_version",
          "description": "Format version of the engine that last wrote it."
        },
        "min_reader_format": {
          "$ref": "#/$defs/fabric.manifest.format_version",
          "description": "Oldest format version that can read it."
        },
        "schema_set": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Digest of the schema set of the head revision."
        },
        "modules": {
          "$ref": "#/$defs/fabric.manifest.module_ranges",
          "description": "Required modules with their admitted version ranges."
        },
        "capabilities": {
          "$ref": "#/$defs/fabric.manifest.string_list",
          "description": "Required capabilities by SL-REG-004 id."
        },
        "target_profiles": {
          "$ref": "#/$defs/fabric.manifest.string_list",
          "description": "Target profiles by SL-GOV-007 name."
        },
        "package_pins": {
          "$ref": "#/$defs/fabric.manifest.package_pins",
          "description": "Pinned packages in resolution order."
        },
        "default_branch": {
          "type": "string",
          "description": "Name of the default branch."
        }
      },
      "required": [
        "project",
        "name",
        "writer_format",
        "min_reader_format",
        "schema_set",
        "modules",
        "capabilities",
        "target_profiles",
        "package_pins",
        "default_branch"
      ],
      "additionalProperties": false,
      "description": "The project manifest at the well-known id (entity, ordinal 1) (ARCH1-R32)."
    },
    "fabric.manifest.module_ranges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/fabric.manifest.version_range"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "description": "Required modules: module id to admitted version range."
    },
    "fabric.manifest.package_pin": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^(?:prj_01|sch_02|typ_03|ast_04|ent_05|ins_06|drv_07|txn_08|evt_09|act_0A|pkg_0B|elm_0C|nsp_0D|ope_0E|imp_0F)0[4-9A-HJK][0-9A-HJKMNP-TV-Z]{22}$",
          "description": "Package id of the pinned package."
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Revision object id the package is pinned to."
        },
        "mount": {
          "type": "string",
          "description": "Mount point of the package inside the project."
        }
      },
      "required": [
        "package",
        "revision",
        "mount"
      ],
      "additionalProperties": false,
      "description": "One pinned package revision and where it is mounted (ARCH1-R66)."
    },
    "fabric.manifest.package_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:elm_0C)0[4-9A-HJK][0-9A-HJKMNP-TV-Z]{22}$"
          },
          "order": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*(?:0[1-9a-f]|[1-9a-f][0-9a-f])$"
          },
          "value": {
            "$ref": "#/$defs/fabric.manifest.package_pin"
          }
        },
        "required": [
          "id",
          "order",
          "value"
        ],
        "additionalProperties": false
      },
      "description": "Package pins in resolution order (ARCH1-R63)."
    },
    "fabric.manifest.string_list": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Strings in order."
    },
    "fabric.manifest.version_range": {
      "type": "object",
      "properties": {
        "at_least": {
          "$ref": "#/$defs/fabric.manifest.format_version",
          "description": "Lowest admitted version, inclusive."
        },
        "below": {
          "$ref": "#/$defs/fabric.manifest.format_version",
          "description": "First version no longer admitted, exclusive."
        }
      },
      "required": [
        "at_least",
        "below"
      ],
      "additionalProperties": false,
      "description": "Admitted versions: at_least inclusive, below exclusive."
    }
  }
}
