{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slicedlabs.example/gen/fabric.history.text.schema.json",
  "title": "Canonical text of module fabric.history (ARCH1-R29, generated by tools/fabric/slgen.py)",
  "$defs": {
    "fabric.history.digest_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$"
      },
      "description": "Object ids in order."
    },
    "fabric.history.origin": {
      "type": "object",
      "properties": {
        "subsystem": {
          "type": "string",
          "description": "Subsystem that made the edit, as its owner number 01 to 12."
        },
        "epistemic": {
          "$ref": "#/$defs/fabric.provenance.epistemic_class",
          "description": "Epistemic class of the facts it writes."
        }
      },
      "required": [
        "subsystem",
        "epistemic"
      ],
      "additionalProperties": false,
      "description": "Where the facts of a transaction come from (ARCH1-R45)."
    },
    "fabric.history.ref_update": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Ref name: 1 to 255 bytes of 0x21 to 0x7E."
        },
        "expected": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Object id the ref holds now; absent when the ref must not exist."
        },
        "target": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Object id the ref moves to."
        }
      },
      "required": [
        "name",
        "target"
      ],
      "additionalProperties": false,
      "description": "One ref move of a commit batch: compare and set from expected to target."
    },
    "fabric.history.revision": {
      "type": "object",
      "properties": {
        "parents": {
          "$ref": "#/$defs/fabric.history.digest_list",
          "description": "Parent revision object ids; empty for the genesis revision."
        },
        "root": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Object id of the root object (records trie and membership map)."
        },
        "schema_set": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Digest of the schema set the revision was written with."
        },
        "tx": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Object id of the tx record that produced this revision."
        },
        "generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(?:(?:900719925474099[2-9]|900719925474[1-8][0-9]{3}|9007199254749[0-9][0-9]{2}|90071992547[5-8][0-9]{4}|900719925479[0-9][0-9]{3}|90071992548[0-9]{5}|90071992549[0-9][0-9]{4}|900719925[5-8][0-9]{6}|9007199259[0-9][0-9]{5}|90071992[6-8][0-9]{7}|900719929[0-9][0-9]{6}|9007199[3-8][0-9]{8}|90071999[0-9][0-9]{7}|9007[2-8][0-9]{11}|90079[0-9][0-9]{10}|9008[0-9]{12}|9009[0-9][0-9]{11}|90[1-8][0-9]{13}|909[0-9][0-9]{12}|9[1-8][0-9]{14}|99[0-9][0-9]{13}|[1-9][0-9]{16}|[1-9][0-9]{17}|[1-9][0-9]{18}|10[0-9][0-9]{17}|1[1-7][0-9]{18}|180[0-9][0-9]{16}|18[1-3][0-9]{17}|1840[0-9][0-9]{15}|184[1-3][0-9]{16}|18440[0-9][0-9]{14}|1844[1-5][0-9]{15}|184460[0-9][0-9]{13}|18446[1-6][0-9]{14}|1844670[0-9][0-9]{12}|184467[1-3][0-9]{13}|18446740[0-9][0-9]{11}|1844674[1-3][0-9]{12}|1844674400[0-9][0-9]{9}|184467440[1-6][0-9]{10}|18446744070[0-9][0-9]{8}|1844674407[1-2][0-9]{9}|184467440730[0-9][0-9]{7}|18446744073[1-6][0-9]{8}|18446744073700[0-9][0-9]{5}|1844674407370[1-8][0-9]{6}|184467440737090[0-9][0-9]{4}|18446744073709[1-4][0-9]{5}|1844674407370950[0-9][0-9]{3}|184467440737095[1-4][0-9]{4}|18446744073709550[0-9][0-9]{2}|184467440737095510[0-9][0-9]{1}|18446744073709551[1-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5]))$"
            }
          ],
          "description": "Longest parent chain to the genesis revision (generation 0)."
        }
      },
      "required": [
        "parents",
        "root",
        "schema_set",
        "tx",
        "generation"
      ],
      "additionalProperties": false,
      "description": "A revision object (kind 6): parents, root, schema set, tx record and generation; no time field (ARCH1-R50)."
    },
    "fabric.history.tx_record": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^(?:prj_01|sch_02|typ_03|ast_04|ent_05|ins_06|drv_07|txn_08|evt_09|act_0A|pkg_0B|elm_0C|nsp_0D|ope_0E|imp_0F)0[4-9A-HJK][0-9A-HJKMNP-TV-Z]{22}$",
          "description": "Actor id of the actor that committed the transaction."
        },
        "origin": {
          "$ref": "#/$defs/fabric.history.origin",
          "description": "Subsystem and epistemic class of the transaction."
        },
        "provenance": {
          "$ref": "#/$defs/fabric.provenance.provenance",
          "description": "Provenance of the derived records it writes."
        },
        "patch": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Object id of the patch object (kind 8) the transaction applied."
        },
        "idempotency_key": {
          "type": "string",
          "description": "Client key that turns a retried commit into a no-op."
        },
        "label": {
          "type": "string",
          "description": "Human label shown in history and undo menus."
        },
        "undo_of": {
          "type": "string",
          "pattern": "^(?:prj_01|sch_02|typ_03|ast_04|ent_05|ins_06|drv_07|txn_08|evt_09|act_0A|pkg_0B|elm_0C|nsp_0D|ope_0E|imp_0F)0[4-9A-HJK][0-9A-HJKMNP-TV-Z]{22}$",
          "description": "Tx id of the transaction this one undoes."
        }
      },
      "required": [
        "actor",
        "origin",
        "patch",
        "label"
      ],
      "additionalProperties": false,
      "description": "A transaction record (kind 7): who committed what and why; no time field."
    },
    "fabric.provenance.digest_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$"
      },
      "description": "Content digests in order."
    },
    "fabric.provenance.epistemic_class": {
      "enum": [
        "observed",
        "imported",
        "asserted",
        "calculated",
        "inferred",
        "accepted"
      ],
      "description": "Epistemic class of a record write (ARCH1-R42)."
    },
    "fabric.provenance.id_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:prj_01|sch_02|typ_03|ast_04|ent_05|ins_06|drv_07|txn_08|evt_09|act_0A|pkg_0B|elm_0C|nsp_0D|ope_0E|imp_0F)0[4-9A-HJK][0-9A-HJKMNP-TV-Z]{22}$"
      },
      "description": "Record ids in order."
    },
    "fabric.provenance.provenance": {
      "type": "object",
      "properties": {
        "input_ids": {
          "$ref": "#/$defs/fabric.provenance.id_list",
          "description": "Record ids of the inputs."
        },
        "input_revisions": {
          "$ref": "#/$defs/fabric.provenance.digest_list",
          "description": "Record content digests of the inputs, one per id."
        },
        "toolchain_id": {
          "type": "string",
          "description": "Id of the toolchain that derived the record."
        },
        "parameters_digest": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Digest of the derivation parameters."
        },
        "environment_hash": {
          "type": "string",
          "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$",
          "description": "Hash of the derivation environment."
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Exactly the five F3 fields; a missing one is provenance_incomplete (ARCH1-R43)."
    }
  }
}
