# vendored provider (WO-018): third_party/<dir> is re-hashed file by file against deps/deps.lock.json at every configure.
# A mismatch or a locked file that is gone is FATAL (integrity, never falls through); a package the lock lists no
# vendored files for is UNAVAILABLE (not vendored yet). The target is IMPORTED INTERFACE with the dir as a SYSTEM include.
function(sl_deps_provider_vendored pkg pjson out_status out_detail out_hash)
  set(${out_hash} "" PARENT_SCOPE)
  _sl_deps_jget(dir "${pjson}" providers vendored dir)
  _sl_deps_jmembers(files "${pjson}" providers vendored files)
  if(NOT dir OR NOT files)
    set(${out_status} UNAVAILABLE PARENT_SCOPE)
    set(${out_detail} "not vendored (the lock lists no files under third_party; `just deps-vendor ${pkg}`)" PARENT_SCOPE)
    return()
  endif()
  set(root "${CMAKE_SOURCE_DIR}/${dir}")
  foreach(rel IN LISTS files)
    _sl_deps_jget(want "${pjson}" providers vendored files "${rel}")
    set(path "${root}/${rel}")
    if(NOT EXISTS "${path}")
      set(${out_status} FATAL PARENT_SCOPE)
      set(${out_detail} "${dir}/${rel} is locked but missing on disk (provider vendored)" PARENT_SCOPE)
      return()
    endif()
    file(SHA256 "${path}" have)
    if(NOT have STREQUAL want)
      set(${out_status} FATAL PARENT_SCOPE)
      set(${out_detail} "${dir}/${rel} sha256 ${have} does not match the lock (${want}) (provider vendored)" PARENT_SCOPE)
      return()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  endforeach()
  _sl_deps_jget(tree "${pjson}" providers vendored tree_sha256)
  add_library(sl_dep_${pkg} INTERFACE IMPORTED GLOBAL)
  target_include_directories(sl_dep_${pkg} SYSTEM INTERFACE "${root}")
  set(${out_status} OK PARENT_SCOPE)
  set(${out_hash} "${tree}" PARENT_SCOPE)
endfunction()
