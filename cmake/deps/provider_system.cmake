# system provider (WO-018). Header-only packages (a `header` entry in the lock): find_path, then accept only when the
# installed header's sha256 is in the lock's accept_sha256 (a string or a list). A tier A package without accept_sha256
# is UNAVAILABLE: a system copy nobody hashed is not content-addressed. Packages located by find_package or by program
# (Vulkan, slangc, spirv-val; tier B) are resolved by their own module (SlVulkan, WO-016), so here they are UNAVAILABLE.
function(sl_deps_provider_system pkg pjson out_status out_detail out_hash)
  set(${out_hash} "" PARENT_SCOPE)
  _sl_deps_jget(header "${pjson}" providers system header)
  if(NOT header)
    set(${out_status} UNAVAILABLE PARENT_SCOPE)
    set(${out_detail} "the lock gives no header to look for (find_package/program packages are resolved by SlVulkan)" PARENT_SCOPE)
    return()
  endif()
  _sl_deps_jget(pacman "${pjson}" providers system pacman)
  find_path(_sl_dep_inc NAMES "${header}" NO_CACHE)
  if(NOT _sl_dep_inc)
    set(${out_status} UNAVAILABLE PARENT_SCOPE)
    set(${out_detail} "${header} not found on the system include path (sudo pacman -Syu --needed ${pacman})" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${_sl_dep_inc}/${header}" have)

  set(accepted "")
  string(JSON t ERROR_VARIABLE e TYPE "${pjson}" providers system accept_sha256)
  if(NOT e AND t STREQUAL "STRING")
    _sl_deps_jget(one "${pjson}" providers system accept_sha256)
    set(accepted "${one}")
  elseif(NOT e AND t STREQUAL "ARRAY")
    string(JSON n LENGTH "${pjson}" providers system accept_sha256)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON h GET "${pjson}" providers system accept_sha256 ${i})
      list(APPEND accepted "${h}")
    endforeach()
  endif()
  if(NOT accepted)
    set(${out_status} UNAVAILABLE PARENT_SCOPE)
    set(${out_detail} "found ${_sl_dep_inc}/${header} but the lock has no accept_sha256 for it" PARENT_SCOPE)
    return()
  endif()
  if(NOT have IN_LIST accepted)
    set(${out_status} UNAVAILABLE PARENT_SCOPE)
    set(${out_detail} "found ${_sl_dep_inc}/${header} but hash not accepted (${have}; the lock accepts ${accepted})" PARENT_SCOPE)
    return()
  endif()
  add_library(sl_dep_${pkg} INTERFACE IMPORTED GLOBAL)
  target_include_directories(sl_dep_${pkg} SYSTEM INTERFACE "${_sl_dep_inc}")
  set(${out_status} OK PARENT_SCOPE)
  set(${out_hash} "${have}" PARENT_SCOPE)
endfunction()
