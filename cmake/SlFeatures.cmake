# C++ feature battery (WO-015, SL-EP-043, SL-EP-044): the C++23 features the code relies on are compiled, not assumed.
#   cmake/features/required-cxx23.txt   one id per line; each has cmake/features/cxx23/<id>.cpp; a failure stops configure
#   cmake/features/deferred-cxx23.txt   candidates that fail on a supported compiler; tested and reported, never fatal
#   cmake/features/probes-cxx26.txt     C++26 probes (cmake/features/cxx26/<id>.cpp); recorded, never fatal
#   cmake/features/matrix.json          what `just features-measure` measured per compiler (docs/build/README.md)
# sl_features_check() order: (1) existence audit in both directions, (2) fingerprint, (3) cache or try_compile,
# (4) results under <build>/features/, (5) a failing required feature stops configure.
# Tests use -std=c++23 -pedantic-errors and no -Werror (clang -Wredundant-consteval-if fires on a naive
# consteval test). A `// sl-link: <lib>` comment in a probe adds -l<lib> when the plain link fails (stacktrace);
# `// sl-compile-only` skips the link (contracts needs a violation handler the probe does not supply).
# Cache variables:
#   SL_FEATURE_TEST_DIR   directory holding the lists and the test files (negative tests point it at a copy)
#   SL_IMPORT_STD_GATE    CMAKE_EXPERIMENTAL_CXX_IMPORT_STD UUID of CMake 4.4.4, inferred from the cmake binary
#                         and UNVERIFIED; the only place it is written. import_std stays a report-only probe.
# Environment: SL_FEATURES_MEASURE=1 ignores the cache and never stops the configure (features-measure).
include_guard(GLOBAL)
include(CheckCXXCompilerFlag)

set(SL_FEATURE_TEST_DIR "${CMAKE_CURRENT_LIST_DIR}/features" CACHE PATH "Directory with the feature lists and tests (cmake/features)")
set(SL_IMPORT_STD_GATE "f35a9ac6-8463-4d38-8eec-5d6008153e7d" CACHE STRING "CMAKE_EXPERIMENTAL_CXX_IMPORT_STD UUID (unverified; report-only probe)")

# --- helpers ---------------------------------------------------------------------------------------------------

# One id per line; '#' starts a comment; blank lines are skipped.
function(_sl_feat_read_list out file)
  set(ids "")
  if(EXISTS "${file}")
    file(STRINGS "${file}" lines)
    foreach(line IN LISTS lines)
      string(REGEX REPLACE "#.*$" "" line "${line}")
      string(STRIP "${line}" line)
      if(NOT line STREQUAL "")
        if(NOT line MATCHES "^[a-z][a-z0-9_]*$")
          message(FATAL_ERROR "sliced: '${line}' in ${file} is not a feature id (lowercase letters, digits and '_')")
        endif()
        list(APPEND ids "${line}")
      endif()
    endforeach()
  endif()
  set(${out} "${ids}" PARENT_SCOPE)
endfunction()

function(_sl_feat_json_quote out text)
  string(REGEX REPLACE "[^ -~]" " " text "${text}")
  string(REPLACE "\\" "\\\\" text "${text}")
  string(REPLACE "\"" "\\\"" text "${text}")
  set(${out} "\"${text}\"" PARENT_SCOPE)
endfunction()

# First error line of a compiler or CMake log, trimmed.
function(_sl_feat_first_error out log)
  set(detail "")
  string(REPLACE ";" "," log "${log}")
  string(REPLACE "\n" ";" lines "${log}")
  foreach(line IN LISTS lines)
    if(line MATCHES "[Ee]rror:" OR line MATCHES "^CMake Error" OR line MATCHES "undefined reference")
      set(detail "${line}")
      break()
    endif()
  endforeach()
  string(STRIP "${detail}" detail)
  string(LENGTH "${detail}" n)
  if(n GREATER 220)
    string(SUBSTRING "${detail}" 0 220 detail)
  endif()
  set(${out} "${detail}" PARENT_SCOPE)
endfunction()

# Short name of the compiler as the matrix knows it: clang, gcc, msvc or clang-cl.
function(_sl_feat_compiler_key out)
  if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set(key msvc)
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(key clang-cl)
  elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set(key clang)
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(key gcc)
  else()
    string(TOLOWER "${CMAKE_CXX_COMPILER_ID}" key)
  endif()
  set(${out} "${key}" PARENT_SCOPE)
endfunction()

# Standard library in use, read from the compiler's own macros (libstdc++-16, libc++-210000, msvc-stl).
function(_sl_feat_stdlib out)
  if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC" OR CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set(${out} "msvc-stl" PARENT_SCOPE)
    return()
  endif()
  set(probe "${CMAKE_BINARY_DIR}/features/stdlib_probe.cpp")
  file(WRITE "${probe}" "#include <version>\n")
  execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -x c++ -std=c++23 -E -dM "${probe}"
    OUTPUT_VARIABLE defs RESULT_VARIABLE rc ERROR_QUIET)
  set(lib "unknown")
  if(rc EQUAL 0)
    if(defs MATCHES "#define _GLIBCXX_RELEASE ([0-9]+)")
      set(lib "libstdc++-${CMAKE_MATCH_1}")
    elseif(defs MATCHES "#define _LIBCPP_VERSION ([0-9]+)")
      set(lib "libc++-${CMAKE_MATCH_1}")
    endif()
  endif()
  set(${out} "${lib}" PARENT_SCOPE)
endfunction()

# _sl_feat_try(<status-var> <detail-var> <source> <std-flags> <log-file>): compile and link one test file.
# status is ok or fail. An `// sl-link: <lib>` comment names a library to retry with when the plain link fails.
function(_sl_feat_try status_var detail_var src flags log_file)
  # try_compile takes CMAKE_CXX_FLAGS from the calling scope (a CMAKE_FLAGS -D is overridden); this function's copy
  # dies with it. No -Werror: -pedantic-errors alone decides.
  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${flags}")
  set(CMAKE_COMPILE_WARNING_AS_ERROR OFF)
  # `// sl-compile-only` builds a static library: no link, for probes that need a user-supplied runtime hook.
  file(STRINGS "${src}" compile_only REGEX "^// sl-compile-only")
  if(compile_only)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  endif()
  set(libs "")
  file(STRINGS "${src}" link_lines REGEX "^// sl-link:")
  foreach(line IN LISTS link_lines)
    string(REGEX REPLACE "^// sl-link:[ ]*" "" lib "${line}")
    string(STRIP "${lib}" lib)
    list(APPEND libs "${lib}")
  endforeach()
  set(attempts "")
  list(APPEND attempts "plain")
  if(libs)
    list(APPEND attempts "linked")
  endif()
  set(ok FALSE)
  set(out "")
  foreach(attempt IN LISTS attempts)
    set(link_args "")
    if(attempt STREQUAL "linked")
      set(link_args LINK_LIBRARIES ${libs})
    endif()
    try_compile(ok SOURCES "${src}" NO_CACHE
      ${link_args}
      OUTPUT_VARIABLE out)
    if(ok)
      break()
    endif()
  endforeach()
  if(ok)
    set(${status_var} "ok" PARENT_SCOPE)
    set(${detail_var} "" PARENT_SCOPE)
  else()
    get_filename_component(log_dir "${log_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${log_dir}")
    file(WRITE "${log_file}" "${out}")
    _sl_feat_first_error(detail "${out}")
    set(${status_var} "fail" PARENT_SCOPE)
    set(${detail_var} "${detail}" PARENT_SCOPE)
  endif()
endfunction()

# The import_std probe: a nested project (CMAKE_CXX_MODULE_STD ON behind the experimental gate) configured and built
# in its own process. try_compile(PROJECT) cannot do this: it reuses the parent's toolchain detection, which ran
# without the gate, so the nested project would never see std module support.
function(_sl_feat_try_import_std status_var detail_var dir log_file)
  set(bindir "${CMAKE_BINARY_DIR}/features/try/import_std")
  file(REMOVE_RECURSE "${bindir}")
  set(out "")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -S "${dir}/cxx26/import_std" -B "${bindir}" -G "${CMAKE_GENERATOR}"
      "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}" "-DCMAKE_BUILD_TYPE=Debug"
      "-DSL_IMPORT_STD_GATE=${SL_IMPORT_STD_GATE}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out TIMEOUT 120)
  if(rc EQUAL 0)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${bindir}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out TIMEOUT 300)
  endif()
  if(rc EQUAL 0)
    set(${status_var} "ok" PARENT_SCOPE)
    set(${detail_var} "" PARENT_SCOPE)
  else()
    get_filename_component(log_dir "${log_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${log_dir}")
    file(WRITE "${log_file}" "${out}")
    _sl_feat_first_error(detail "${out}")
    if(detail STREQUAL "")
      set(detail "nested import std project failed (exit ${rc})")
    endif()
    set(${status_var} "unavailable" PARENT_SCOPE)
    set(${detail_var} "${detail}" PARENT_SCOPE)
  endif()
endfunction()

# --- the check -------------------------------------------------------------------------------------------------

function(sl_features_check)
  set(dir "${SL_FEATURE_TEST_DIR}")
  set(measure FALSE)
  if("$ENV{SL_FEATURES_MEASURE}" STREQUAL "1")
    set(measure TRUE)
  endif()
  set(fdir "${CMAKE_BINARY_DIR}/features")
  set(req_file "${dir}/required-cxx23.txt")
  set(def_file "${dir}/deferred-cxx23.txt")
  set(probe_file "${dir}/probes-cxx26.txt")

  if(NOT EXISTS "${req_file}")
    message(FATAL_ERROR "sliced: cmake/features/required-cxx23.txt is missing (looked in ${dir}). "
      "Without the manifest nothing proves the C++23 features the code relies on.")
  endif()
  _sl_feat_read_list(required "${req_file}")
  _sl_feat_read_list(deferred "${def_file}")
  _sl_feat_read_list(probes "${probe_file}")

  # (1) existence audit, both directions, before any cache is consulted
  foreach(id IN LISTS required)
    if(NOT EXISTS "${dir}/cxx23/${id}.cpp")
      message(FATAL_ERROR "sliced: required C++23 feature test '${id}' is listed in cmake/features/required-cxx23.txt "
        "but cmake/features/cxx23/${id}.cpp does not exist. A deleted test hides a feature the code relies on. "
        "Restore the file, or remove the id through an ADR (SL-GOV-004) and a change to SL-EP-043.")
    endif()
    if(id IN_LIST deferred)
      message(FATAL_ERROR "sliced: C++23 feature '${id}' is listed in both cmake/features/required-cxx23.txt and "
        "cmake/features/deferred-cxx23.txt. Keep it in one list.")
    endif()
  endforeach()
  foreach(id IN LISTS deferred)
    if(NOT EXISTS "${dir}/cxx23/${id}.cpp")
      message(FATAL_ERROR "sliced: deferred C++23 feature test '${id}' is listed in cmake/features/deferred-cxx23.txt "
        "but cmake/features/cxx23/${id}.cpp does not exist. Restore the file or remove the id from the list.")
    endif()
  endforeach()
  file(GLOB test_files CONFIGURE_DEPENDS "${dir}/cxx23/*.cpp")
  list(SORT test_files)
  foreach(file IN LISTS test_files)
    get_filename_component(id "${file}" NAME_WE)
    if(NOT id IN_LIST required AND NOT id IN_LIST deferred)
      message(FATAL_ERROR "sliced: C++23 feature test cmake/features/cxx23/${id}.cpp is in neither "
        "cmake/features/required-cxx23.txt nor cmake/features/deferred-cxx23.txt. An unlisted test is never run. "
        "List the id (required after `just features-measure`, or deferred), or delete the file.")
    endif()
  endforeach()
  file(GLOB probe_files CONFIGURE_DEPENDS "${dir}/cxx26/*.cpp")
  foreach(file IN LISTS probe_files)
    get_filename_component(id "${file}" NAME_WE)
    if(NOT id IN_LIST probes)
      message(STATUS "sliced: C++26 probe cmake/features/cxx26/${id}.cpp is not listed in probes-cxx26.txt (skipped)")
    endif()
  endforeach()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${req_file}" "${def_file}" "${probe_file}")

  # (2) flags and fingerprint
  _sl_feat_compiler_key(ckey)
  _sl_feat_stdlib(stdlib)
  set(msvc_frontend OFF)
  if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC" OR CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set(msvc_frontend ON)
  endif()
  if(msvc_frontend)
    set(flags23 "/std:c++latest /permissive- /Zc:__cplusplus /EHsc")
    set(flags26 "/std:c++latest /permissive- /Zc:__cplusplus /EHsc")
  else()
    if(COMMAND _sl_probe)
      _sl_probe(-std=c++23 has23)
      _sl_probe(-std=c++26 has26)
    else()
      check_cxx_compiler_flag(-std=c++23 has23)
      check_cxx_compiler_flag(-std=c++26 has26)
    endif()
    if(NOT has23)
      message(FATAL_ERROR "sliced: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION} does not accept -std=c++23, "
        "which the C++23 baseline requires")
    endif()
    set(flags23 "-std=c++23 -pedantic-errors")
    set(flags26 "-std=c++26 -pedantic-errors")
  endif()
  string(TOUPPER "${CMAKE_BUILD_TYPE}" cfg)
  set(fp "${ckey}|${CMAKE_CXX_COMPILER_ID}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_CXX_COMPILER_FRONTEND_VARIANT}|${stdlib}")
  string(APPEND fp "|${flags23}|${flags26}|${CMAKE_CXX_FLAGS}|${CMAKE_CXX_FLAGS_${cfg}}|${SL_IMPORT_STD_GATE}")
  file(SHA256 "${req_file}" manifest_sha)
  string(APPEND fp "|manifest ${manifest_sha}")
  foreach(file IN ITEMS "${def_file}" "${probe_file}" "${dir}/cxx26/import_std/CMakeLists.txt" "${dir}/cxx26/import_std/main.cpp")
    if(EXISTS "${file}")
      file(SHA256 "${file}" sha)
      string(APPEND fp "|${sha}")
    endif()
  endforeach()
  foreach(file IN LISTS test_files probe_files)
    file(SHA256 "${file}" sha)
    string(APPEND fp "|${sha}")
  endforeach()
  string(SHA256 key "${fp}")

  # (3) cache or run
  file(MAKE_DIRECTORY "${fdir}/cache")
  set(cache_file "${fdir}/cache/${key}.json")
  set(from_cache FALSE)
  set(all23 ${required} ${deferred})
  if(NOT measure AND EXISTS "${cache_file}")
    file(READ "${cache_file}" cached)
    set(complete TRUE)
    foreach(id IN LISTS all23)
      string(JSON st ERROR_VARIABLE err GET "${cached}" cxx23 "${id}" status)
      if(err)
        set(complete FALSE)
      else()
        string(JSON dt GET "${cached}" cxx23 "${id}" detail)
        set(res23_${id} "${st}")
        set(det23_${id} "${dt}")
      endif()
    endforeach()
    foreach(id IN LISTS probes)
      string(JSON st ERROR_VARIABLE err GET "${cached}" cxx26 "${id}" status)
      if(err)
        set(complete FALSE)
      else()
        string(JSON dt GET "${cached}" cxx26 "${id}" detail)
        set(res26_${id} "${st}")
        set(det26_${id} "${dt}")
      endif()
    endforeach()
    set(from_cache ${complete})
  endif()
  if(NOT from_cache)
    file(REMOVE_RECURSE "${fdir}/log")
    foreach(id IN LISTS all23)
      _sl_feat_try(st dt "${dir}/cxx23/${id}.cpp" "${flags23}" "${fdir}/log/cxx23-${id}.log")
      set(res23_${id} "${st}")
      set(det23_${id} "${dt}")
    endforeach()
    foreach(id IN LISTS probes)
      if(id STREQUAL "import_std" AND EXISTS "${dir}/cxx26/import_std/CMakeLists.txt")
        _sl_feat_try_import_std(st dt "${dir}" "${fdir}/log/cxx26-import_std.log")
      elseif(EXISTS "${dir}/cxx26/${id}.cpp")
        _sl_feat_try(st dt "${dir}/cxx26/${id}.cpp" "${flags26}" "${fdir}/log/cxx26-${id}.log")
      else()
        set(st "missing")
        set(dt "cmake/features/cxx26/${id}.cpp does not exist")
      endif()
      set(res26_${id} "${st}")
      set(det26_${id} "${dt}")
    endforeach()
  endif()

  # (4) results and the C++26 report
  _sl_feat_json_quote(q_fp "${key}")
  _sl_feat_json_quote(q_man "${manifest_sha}")
  _sl_feat_json_quote(q_key "${ckey}")
  _sl_feat_json_quote(q_id "${CMAKE_CXX_COMPILER_ID}")
  _sl_feat_json_quote(q_ver "${CMAKE_CXX_COMPILER_VERSION}")
  _sl_feat_json_quote(q_lib "${stdlib}")
  _sl_feat_json_quote(q_f23 "${flags23}")
  _sl_feat_json_quote(q_f26 "${flags26}")
  _sl_feat_json_quote(q_pre "${SL_PRESET}")
  set(compiler "{\"key\":${q_key},\"id\":${q_id},\"version\":${q_ver},\"stdlib\":${q_lib},\"preset\":${q_pre},\"flags_cxx23\":${q_f23},\"flags_cxx26\":${q_f26}}")
  set(j23 "")
  set(sep "")
  foreach(id IN LISTS all23)
    set(is_req false)
    if(id IN_LIST required)
      set(is_req true)
    endif()
    _sl_feat_json_quote(q_st "${res23_${id}}")
    _sl_feat_json_quote(q_dt "${det23_${id}}")
    string(APPEND j23 "${sep}\"${id}\":{\"status\":${q_st},\"required\":${is_req},\"detail\":${q_dt}}")
    set(sep ",")
  endforeach()
  set(j26 "")
  set(sep "")
  foreach(id IN LISTS probes)
    _sl_feat_json_quote(q_st "${res26_${id}}")
    _sl_feat_json_quote(q_dt "${det26_${id}}")
    string(APPEND j26 "${sep}\"${id}\":{\"status\":${q_st},\"detail\":${q_dt}}")
    set(sep ",")
  endforeach()
  set(results "{\"schema\":\"sl-features-results/1\",\"fingerprint\":${q_fp},\"manifest_sha256\":${q_man},\"compiler\":${compiler},\"cxx23\":{${j23}},\"cxx26\":{${j26}}}\n")
  set(report "{\"schema\":\"sl-cxx26-report/1\",\"compiler\":${compiler},\"probes\":{${j26}}}\n")
  file(GLOB old_caches "${fdir}/cache/*.json")
  list(REMOVE_ITEM old_caches "${cache_file}")
  if(old_caches)
    file(REMOVE ${old_caches})
  endif()
  file(WRITE "${cache_file}" "${results}")
  file(WRITE "${fdir}/results.json" "${results}")
  file(WRITE "${fdir}/cxx26-report.json" "${report}")

  # (5) verdict
  set(failed "")
  set(n_ok 0)
  foreach(id IN LISTS required)
    if(res23_${id} STREQUAL "ok")
      math(EXPR n_ok "${n_ok} + 1")
    else()
      list(APPEND failed "${id}")
    endif()
  endforeach()
  list(LENGTH required n_req)
  list(LENGTH deferred n_def)
  set(n26_ok 0)
  foreach(id IN LISTS probes)
    if(res26_${id} STREQUAL "ok")
      math(EXPR n26_ok "${n26_ok} + 1")
    endif()
  endforeach()
  list(LENGTH probes n26)
  set(origin "measured")
  if(from_cache)
    set(origin "cached")
  endif()
  message(STATUS "sliced: C++23 features ${n_ok}/${n_req} required ok, ${n_def} deferred (${origin}, ${ckey} ${CMAKE_CXX_COMPILER_VERSION}, ${stdlib})")
  message(STATUS "sliced: C++26 probes ${n26_ok}/${n26} ok, report only (${fdir}/cxx26-report.json)")
  if(failed AND NOT measure)
    list(GET failed 0 first)
    list(LENGTH failed n_failed)
    string(REPLACE ";" ", " failed_text "${failed}")
    message(FATAL_ERROR "sliced: required C++23 feature '${first}' failed to compile with ${CMAKE_CXX_COMPILER_ID} "
      "${CMAKE_CXX_COMPILER_VERSION} (${stdlib}, ${flags23}): ${det23_${first}}. "
      "${n_failed} failing: ${failed_text}. Compiler log: ${fdir}/log/cxx23-${first}.log. "
      "A compiler that cannot build a required feature is not supported; the list changes only through an ADR (SL-GOV-004) "
      "and a change to SL-EP-043.")
  endif()
endfunction()
