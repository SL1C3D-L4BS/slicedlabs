# Doxygen configuration for the public C++ API (WO-031). Run from the repository root:
#   doxygen docs/Doxyfile        (done by `just docs` when doxygen is on PATH)
# Output: build/docs/api/html. Warnings are errors.
PROJECT_NAME           = "Sliced Labs Engine"
PROJECT_BRIEF          = "Public headers of engine/core"
OUTPUT_DIRECTORY       = build/docs/api
CREATE_SUBDIRS         = NO
INPUT                  = engine/core/include
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp
STRIP_FROM_PATH        = engine/core/include
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
HAVE_DOT               = NO
SOURCE_BROWSER         = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
