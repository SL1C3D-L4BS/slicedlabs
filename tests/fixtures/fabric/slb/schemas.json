{
"format": "slb-corpus-schemas/1",
"types": {
"bool": {"kind": "bool"},
"u8": {"bits": 8, "kind": "uint"},
"u64": {"kind": "uint"},
"i64": {"kind": "int"},
"i65": {"bits": 65, "kind": "int"},
"f32": {"kind": "f32"},
"f64": {"kind": "f64"},
"string": {"kind": "string"},
"bytes": {"kind": "bytes"},
"id": {"kind": "id"},
"digest": {"kind": "digest"},
"color": {"enumerators": [{"no": 0, "name": "red"}, {"no": 1, "name": "green"}, {"no": 2, "name": "blue"}], "kind": "enum"},
"list_u64": {"element": "u64", "kind": "list"},
"list_string": {"element": "string", "kind": "list"},
"list_list_u64": {"element": "list_u64", "kind": "list"},
"list_scalar": {"element": "scalar", "kind": "list"},
"map_string_u64": {"key": "string", "value": "u64", "kind": "map"},
"map_u64_string": {"key": "uint", "value": "string", "kind": "map"},
"map_i64_u64": {"key": "int", "value": "u64", "kind": "map"},
"map_id_string": {"key": "id", "value": "string", "kind": "map"},
"map_string_point": {"key": "string", "value": "point", "kind": "map"},
"empty": {"fields": [], "kind": "struct"},
"point": {"fields": [{"no": 1, "name": "x", "type": "f64"}, {"no": 2, "name": "y", "type": "f64"}], "kind": "struct"},
"rec_ab": {"fields": [{"no": 1, "name": "a", "type": "u64"}, {"no": 2, "name": "b", "type": "string", "optional": true}], "kind": "struct"},
"cfg": {"fields": [{"no": 1, "name": "retries", "type": "u64", "optional": true, "default": 3}, {"no": 2, "name": "name", "type": "string", "optional": true, "default": ""}], "kind": "struct"},
"wide": {"fields": [{"no": 0, "name": "f0", "type": "u64"}, {"no": 127, "name": "f127", "type": "u64"}, {"no": 128, "name": "f128", "type": "u64"}, {"no": 16384, "name": "f16384", "type": "u64"}, {"no": 4294967295, "name": "fmax", "type": "u64"}], "kind": "struct"},
"user": {"fields": [{"no": 1, "name": "name", "type": "string"}, {"no": 2, "name": "pos", "type": "point"}, {"no": 3, "name": "tags", "type": "list_string", "optional": true}, {"no": 4, "name": "attrs", "type": "map_string_u64", "optional": true}, {"no": 5, "name": "shape", "type": "shape", "optional": true}], "kind": "struct"},
"all_scalars": {"fields": [{"no": 1, "name": "flag", "type": "bool"}, {"no": 2, "name": "small", "type": "u8"}, {"no": 3, "name": "count", "type": "u64"}, {"no": 4, "name": "delta", "type": "i64"}, {"no": 5, "name": "ratio32", "type": "f32"}, {"no": 6, "name": "ratio64", "type": "f64"}, {"no": 7, "name": "label", "type": "string"}, {"no": 8, "name": "blob", "type": "bytes"}, {"no": 9, "name": "ref", "type": "id"}, {"no": 10, "name": "hash", "type": "digest"}, {"no": 11, "name": "tint", "type": "color"}], "kind": "struct"},
"recs": {"element": "rec_ab", "kind": "list"},
"map_string_rec": {"key": "string", "value": "rec_ab", "kind": "map"},
"scalar": {"cases": [{"no": 1, "name": "flag", "type": "bool"}, {"no": 2, "name": "count", "type": "u64"}, {"no": 3, "name": "delta", "type": "i64"}, {"no": 4, "name": "ratio", "type": "f64"}, {"no": 5, "name": "label", "type": "string"}, {"no": 6, "name": "blob", "type": "bytes"}, {"no": 7, "name": "ref", "type": "id"}, {"no": 8, "name": "hash", "type": "digest"}], "kind": "variant"},
"shape": {"cases": [{"no": 1, "name": "circle", "type": "f64"}, {"no": 2, "name": "rect", "type": "point"}, {"no": 3, "name": "none", "type": "empty"}], "kind": "variant"},
"wide_variant": {"cases": [{"no": 0, "name": "c0", "type": "u64"}, {"no": 127, "name": "c127", "type": "u64"}, {"no": 128, "name": "c128", "type": "u64"}, {"no": 4294967295, "name": "cmax", "type": "u64"}], "kind": "variant"},
"oset_string": {"element": "string", "kind": "oset"},
"oset_u64": {"element": "u64", "kind": "oset"},
"oset_rec": {"element": "rec_ab", "kind": "oset"},
"deep_list": {"element": "deep_list", "kind": "list"},
"deep_struct": {"fields": [{"no": 1, "name": "next", "type": "deep_struct", "optional": true}], "kind": "struct"},
"deep_map": {"key": "string", "value": "deep_map", "kind": "map"},
"deep_variant": {"cases": [{"no": 1, "name": "next", "type": "deep_variant"}, {"no": 2, "name": "end", "type": "bool"}], "kind": "variant"},
"deep_oset": {"element": "deep_oset", "kind": "oset"},
"deep_alt_list": {"element": "deep_alt_struct", "kind": "list"},
"deep_alt_struct": {"fields": [{"no": 1, "name": "next", "type": "deep_alt_list", "optional": true}], "kind": "struct"}
}
}
