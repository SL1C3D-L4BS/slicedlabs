    "corruption": [
      {"class": "C1", "detect": "R4", "evidence": "lost_bytes", "name": "torn tail", "policy": "quarantine tail bytes, truncate, open normally"},
      {"class": "C2", "detect": "R4", "evidence": "offset, commits after damage", "name": "mid-log CRC mismatch", "policy": "quarantine segment copy, read-only view at last intact commit before damage"},
      {"class": "C3", "detect": "R5", "evidence": "seq, expected and found prev", "name": "broken chain or seq gap", "policy": "as C2"},
      {"class": "C4", "detect": "R5, R9, read verify", "evidence": "oid, records affected", "name": "object hash mismatch", "policy": "quarantine object, open newest revision whose closure verifies"},
      {"class": "C5", "detect": "R5, R9", "evidence": "oid, records affected", "name": "missing object", "policy": "as C4"},
      {"class": "C6", "detect": "decode", "evidence": "oid, rule, offset", "name": "undecodable record", "policy": "quarantine, read-only, repair proposal"},
      {"class": "C7", "detect": "check under stored schema_set", "evidence": "record id, diagnostics", "name": "schema-invalid record", "policy": "flag record read-only, repair proposal"},
      {"class": "C8", "detect": "R2, frame header", "evidence": "found and supported version", "name": "unknown newer format", "policy": "refuse format_unsupported, touch nothing"},
      {"class": "C9", "detect": "fsck", "evidence": "from, to, path", "name": "dangling strong reference at rest", "policy": "report, repair proposal (weaken or restore)"},
      {"class": "C10", "detect": "fsck, decode", "evidence": "record id, type record class", "name": "id-class confusion", "policy": "quarantine record"},
      {"class": "C11", "detect": "R1", "evidence": "previous holder info", "name": "stale lock", "policy": "take over, report"},
      {"class": "C12", "detect": "R3", "evidence": "file name", "name": "corrupt checkpoint", "policy": "ignore, rebuild, report"}
    ],
    "epistemic": {"classes": ["observed", "imported", "asserted", "calculated", "inferred", "accepted"], "transitions": [{"from": "imported", "to": "accepted"}, {"from": "asserted", "to": "accepted"}, {"from": "calculated", "to": "accepted"}, {"from": "inferred", "to": "accepted"}]},
