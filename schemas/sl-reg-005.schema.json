{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slicedlabs.example/schemas/sl-reg-005.schema.json",
  "title": "SL-REG-005 episode status view",
  "type": "object",
  "properties": {
    "schema": {
      "const": "sl-reg-005/1"
    },
    "source": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "registry",
        "lock_sha256"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 1
        },
        "last": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "first",
        "last"
      ],
      "additionalProperties": false
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "schema",
    "source",
    "range",
    "episodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "ep_id": {
      "type": "string",
      "pattern": "^SL-EP-[0-9]{3}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ep_id"
        },
        "status": {
          "enum": [
            "Planned",
            "Specified",
            "InProgress",
            "Verifying",
            "Demonstrated",
            "Accepted",
            "Blocked",
            "Reopened"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "open_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "status",
        "revision",
        "evidence",
        "open_issues"
      ],
      "additionalProperties": false
    }
  }
}
