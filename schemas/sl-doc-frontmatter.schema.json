{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slicedlabs.example/schemas/sl-doc-frontmatter.schema.json",
  "title": "Controlled document front matter",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/doc_id"
    },
    "kind": {
      "enum": [
        "GOV",
        "ARCH",
        "PLAN",
        "OPS",
        "REG",
        "VOL"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "Draft",
        "InReview",
        "Approved",
        "Superseded"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "episodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doc_id"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doc_id"
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adr_id"
      },
      "uniqueItems": true
    },
    "max_lines": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "status",
    "version",
    "owner",
    "episodes",
    "depends_on",
    "supersedes",
    "decisions"
  ],
  "additionalProperties": false,
  "$defs": {
    "doc_id": {
      "type": "string",
      "pattern": "^SL-[A-Z]+-[0-9]{2,3}(-SPEC)?$"
    },
    "adr_id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}$"
    }
  }
}
