{
  "version": 8,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {"name": "base", "hidden": true, "generator": "Ninja", "binaryDir": "${sourceDir}/build/${presetName}", "cacheVariables": {"SL_PRESET": "${presetName}"}},
    {"name": "clang", "hidden": true, "inherits": "base", "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++"}},
    {"name": "gcc", "hidden": true, "inherits": "base", "cacheVariables": {"CMAKE_CXX_COMPILER": "g++"}},
    {"name": "msvc", "hidden": true, "inherits": "base", "cacheVariables": {"CMAKE_CXX_COMPILER": "cl"}, "architecture": {"value": "x64", "strategy": "external"}},
    {"name": "clangcl", "hidden": true, "inherits": "base", "cacheVariables": {"CMAKE_CXX_COMPILER": "clang-cl"}, "architecture": {"value": "x64", "strategy": "external"}},
    {"name": "ci", "hidden": true, "inherits": "base", "cacheVariables": {"SL_WARNINGS_AS_ERRORS": "ON"}},
    {"name": "debug", "description": "clang, Debug, C++23 (the default developer build)", "inherits": "clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "release", "description": "clang, Release", "inherits": "clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "asan", "description": "clang, AddressSanitizer", "inherits": "clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SL_SANITIZE": "address"}},
    {"name": "ubsan", "description": "clang, UndefinedBehaviorSanitizer (no recovery)", "inherits": "clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SL_SANITIZE": "undefined"}},
    {"name": "tsan", "description": "clang, ThreadSanitizer", "inherits": "clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SL_SANITIZE": "thread"}},
    {"name": "gcc-debug", "description": "gcc, Debug", "inherits": "gcc", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "gcc-release", "description": "gcc, Release", "inherits": "gcc", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "ci-clang", "description": "clang, Debug, warnings as errors", "inherits": ["clang", "ci"], "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "ci-gcc", "description": "gcc, Debug, warnings as errors", "inherits": ["gcc", "ci"], "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "ci-asan", "description": "clang, AddressSanitizer, warnings as errors", "inherits": ["clang", "ci"], "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SL_SANITIZE": "address"}},
    {"name": "ci-ubsan", "description": "clang, UndefinedBehaviorSanitizer, warnings as errors", "inherits": ["clang", "ci"], "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SL_SANITIZE": "undefined"}},
    {"name": "ci-tsan", "description": "clang, ThreadSanitizer, warnings as errors", "inherits": ["clang", "ci"], "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SL_SANITIZE": "thread"}},
    {"name": "ci-release", "description": "clang, Release, warnings as errors", "inherits": ["clang", "ci"], "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "cxx26", "description": "clang, Debug, C++26 (opt-in standard)", "inherits": "clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SL_CXX_STANDARD": "26"}},
    {"name": "win-msvc-debug", "description": "MSVC cl, Debug (Windows hosts only; unverified here)", "inherits": "msvc", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}, "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "win-clangcl-debug", "description": "clang-cl, Debug (Windows hosts only; unverified here)", "inherits": "clangcl", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}, "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "vcpkg-debug", "description": "clang, Debug, vcpkg toolchain (needs VCPKG_ROOT)", "inherits": "clang", "condition": {"type": "notEquals", "lhs": "$env{VCPKG_ROOT}", "rhs": ""}, "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "VCPKG_MANIFEST_DIR": "${sourceDir}/deps/vcpkg", "SL_DEPS_PROVIDERS": "vcpkg"}},
    {"name": "cpm-debug", "description": "clang, Debug, dependencies only through the cpm provider (offline: needs a pinned lock and a seeded cache)", "inherits": "clang", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SL_DEPS_PROVIDERS": "cpm", "SL_OFFLINE": "ON"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "ubsan", "configurePreset": "ubsan"},
    {"name": "tsan", "configurePreset": "tsan"},
    {"name": "gcc-debug", "configurePreset": "gcc-debug"},
    {"name": "gcc-release", "configurePreset": "gcc-release"},
    {"name": "ci-clang", "configurePreset": "ci-clang"},
    {"name": "ci-gcc", "configurePreset": "ci-gcc"},
    {"name": "ci-asan", "configurePreset": "ci-asan"},
    {"name": "ci-ubsan", "configurePreset": "ci-ubsan"},
    {"name": "ci-tsan", "configurePreset": "ci-tsan"},
    {"name": "ci-release", "configurePreset": "ci-release"},
    {"name": "cxx26", "configurePreset": "cxx26"},
    {"name": "win-msvc-debug", "configurePreset": "win-msvc-debug", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "win-clangcl-debug", "configurePreset": "win-clangcl-debug", "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "vcpkg-debug", "configurePreset": "vcpkg-debug", "condition": {"type": "notEquals", "lhs": "$env{VCPKG_ROOT}", "rhs": ""}},
    {"name": "cpm-debug", "configurePreset": "cpm-debug"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "ubsan", "configurePreset": "ubsan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "gcc-debug", "configurePreset": "gcc-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "gcc-release", "configurePreset": "gcc-release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "ci-clang", "configurePreset": "ci-clang", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "ci-gcc", "configurePreset": "ci-gcc", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "ci-asan", "configurePreset": "ci-asan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "ci-ubsan", "configurePreset": "ci-ubsan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "ci-tsan", "configurePreset": "ci-tsan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "ci-release", "configurePreset": "ci-release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "cxx26", "configurePreset": "cxx26", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "win-msvc-debug", "configurePreset": "win-msvc-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}, "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "win-clangcl-debug", "configurePreset": "win-clangcl-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}, "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}},
    {"name": "vcpkg-debug", "configurePreset": "vcpkg-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}, "condition": {"type": "notEquals", "lhs": "$env{VCPKG_ROOT}", "rhs": ""}},
    {"name": "cpm-debug", "configurePreset": "cpm-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ],
  "workflowPresets": [
    {"name": "debug", "steps": [{"type": "configure", "name": "debug"}, {"type": "build", "name": "debug"}, {"type": "test", "name": "debug"}]},
    {"name": "gcc-debug", "steps": [{"type": "configure", "name": "gcc-debug"}, {"type": "build", "name": "gcc-debug"}, {"type": "test", "name": "gcc-debug"}]},
    {"name": "ci-clang", "steps": [{"type": "configure", "name": "ci-clang"}, {"type": "build", "name": "ci-clang"}, {"type": "test", "name": "ci-clang"}]},
    {"name": "ci-gcc", "steps": [{"type": "configure", "name": "ci-gcc"}, {"type": "build", "name": "ci-gcc"}, {"type": "test", "name": "ci-gcc"}]},
    {"name": "ci-asan", "steps": [{"type": "configure", "name": "ci-asan"}, {"type": "build", "name": "ci-asan"}, {"type": "test", "name": "ci-asan"}]}
  ]
}
